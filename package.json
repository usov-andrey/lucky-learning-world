{
  "name": "lucky-learning-world",
  "version": "1.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-exclude=v1/** --test-coverage-exclude=v2/** --test-coverage-exclude=app.js tests/*.test.mjs",
    "test:coverage:gate": "npm run test:coverage -- --test-coverage-lines=65 --test-coverage-branches=60 --test-coverage-functions=60",
    "task:new": "node scripts/task-new.mjs",
    "task:sync": "node scripts/sync-issues.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
